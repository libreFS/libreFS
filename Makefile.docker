# Makefile.docker — Docker-based development wrapper
# All dev tasks run inside Docker. No Go toolchain or other tools required on the host.
#
# Quick start:
#   make -f Makefile.docker image      — build the dev Docker image (required once)
#   make -f Makefile.docker build      — compile the librefs binary
#   make -f Makefile.docker test       — run all unit tests
#   make -f Makefile.docker verifiers  — run linters and code-gen checks
#   make -f Makefile.docker run        — start the server (S3 on :9000, console on :9001)
#   make -f Makefile.docker clean      — remove build artifacts
#
# The underlying build targets (used inside the container) live in Makefile.

DEV_IMAGE           ?= librefs-dev:latest
DATA_DIR            ?= /tmp/librefs-data
MINIO_ROOT_USER     ?= admin
MINIO_ROOT_PASSWORD ?= password

CONSOLE_DIR     ?= $(dir $(CURDIR))console
LIBREFS_CLI_DIR ?= $(dir $(CURDIR))librefs-cli

DOCKER_RUN := docker run --rm \
	-v "$(CURDIR)":/app \
	-v "$(CONSOLE_DIR)":/console \
	-v "$(LIBREFS_CLI_DIR)":/librefs-cli \
	-w /app \
	$(DEV_IMAGE)

.PHONY: all image build test verifiers lint clean run help

all: build

image: ## build the dev Docker image (Dockerfile.dev)
	docker build -t $(DEV_IMAGE) -f Dockerfile.dev .

build: ## compile the librefs binary (inside Docker)
	$(DOCKER_RUN) make build

test: ## run all unit tests (inside Docker)
	$(DOCKER_RUN) make test

verifiers: ## run linters and code-gen checks (inside Docker)
	$(DOCKER_RUN) make verifiers

lint: ## run golangci-lint (inside Docker)
	$(DOCKER_RUN) make lint

clean: ## remove generated build artifacts (inside Docker)
	$(DOCKER_RUN) make clean

run: build ## start librefs server locally (S3 on :9000, console on :9001)
	@mkdir -p $(DATA_DIR)
	docker run --rm \
		-e MINIO_ROOT_USER=$(MINIO_ROOT_USER) \
		-e MINIO_ROOT_PASSWORD=$(MINIO_ROOT_PASSWORD) \
		-p 9000:9000 \
		-p 9001:9001 \
		-v "$(DATA_DIR)":/data \
		-v "$(CURDIR)":/app \
		-w /app \
		$(DEV_IMAGE) \
		./librefs server /data --console-address :9001

help: ## print this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' Makefile.docker | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'
